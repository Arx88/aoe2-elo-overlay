{
  "appId": "com.local.aoe2elooverlay",
  "productName": "Relic",
  "asar": true,
  "asarUnpack": [
    "node_modules/aoe2rec-js/**/*",
    "assets/icon.ico",
    "assets/app-icon.png"
  ],
  "npmRebuild": false,
  "directories": {
    "output": "dist"
  },
  "files": [
    "main.js",
    "preload.js",
    "renderer.js",
    "index.html",
    "styles.css",
    "theme.css",
    "command.css",
    "arte-launcher.css",
    "arte-overlay.css",
    "arte-aperturas.css",
    "wizard.css",
    "training.css",
    "ui/**/*",
    "settings.html",
    "settings.css",
    "settings.js",
    "settings-preload.js",
    "src/**/*",
    "assets/**/*",
    "!assets/app-icon-source.png",
    "!admin-app/**",
    "!licensing-api/**",
    "!build/**",
    "!tools/**",
    "!dist/**",
    "!run.log",
    "!demo-shot*.png",
    "!demo-*.png",
    "!settings-shot*.png",
    "!config.json",
    "!electron-builder.json"
  ],
  "win": {
    "target": [
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "assets/icon.ico",
    "artifactName": "${productName} Setup ${version}.${ext}"
  },
  "portable": {
    "artifactName": "${productName} ${version} portable.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "shortcutName": "Relic",
    "differentialPackage": true,
    "installerSidebar": "build/installer-estandarte.bmp",
    "uninstallerSidebar": "build/installer-estandarte.bmp",
    "installerHeader": "build/installer-torres.bmp",
    "installerIcon": "assets/icon.ico",
    "uninstallerIcon": "assets/icon.ico",
    "installerHeaderIcon": "assets/icon.ico",
    "include": "build/installer.nsh",
    "displayLanguageSelector": true,
    "installerLanguages": [
      "en_US",
      "es_ES",
      "zh_CN"
    ]
  },
  "publish": [
    {
      "provider": "github",
      "owner": "Arx88",
      "repo": "aoe2-elo-overlay",
      "releaseType": "release"
    }
  ]
}
