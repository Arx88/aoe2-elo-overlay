{
  "appId": "com.local.aoe2elooverlay",
  "productName": "AoE2 ELO Overlay",
  "asar": true,
  "asarUnpack": [
    "node_modules/aoe2rec-js/**/*"
  ],
  "npmRebuild": false,
  "directories": {
    "output": "dist"
  },
  "files": [
    "main.js",
    "preload.js",
    "renderer.js",
    "index.html",
    "styles.css",
    "theme.css",
    "command.css",
    "ui/**/*",
    "settings.html",
    "settings.css",
    "settings.js",
    "settings-preload.js",
    "src/**/*",
    "assets/**/*",
    "!assets/app-icon-source.png",
    "!tools/**",
    "!dist/**",
    "!run.log",
    "!demo-shot*.png",
    "!demo-*.png",
    "!settings-shot*.png",
    "!config.json",
    "!electron-builder.json"
  ],
  "win": {
    "target": [
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "assets/icon.ico",
    "artifactName": "${productName} Setup ${version}.${ext}"
  },
  "portable": {
    "artifactName": "${productName} ${version} portable.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "shortcutName": "AoE2 ELO Overlay",
    "differentialPackage": true
  },
  "publish": [
    {
      "provider": "github",
      "owner": "Arx88",
      "repo": "aoe2-elo-overlay",
      "releaseType": "release"
    }
  ]
}
