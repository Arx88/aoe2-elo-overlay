{
  "name": "aoe2-elo-overlay",
  "version": "0.1.22",
  "private": true,
  "description": "Overlay de ELO para Age of Empires II: DE (elo actual + pico 1v1 RM de los jugadores de la partida en curso)",
  "author": "AoE2 ELO Overlay",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "selftest": "node tools/selftest.js",
    "pack": "electron-builder --win --dir",
    "dist": "electron-builder --win",
    "release": "electron-builder --win -p always",
    "setup:updates": "node tools/setup-updates.js",
    "watch:publish": "node tools/auto-publish.js",
    "publish:once": "node tools/auto-publish.js --once",
    "autostart": "node tools/install-autostart.js"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Arx88/aoe2-elo-overlay.git"
  }
}
